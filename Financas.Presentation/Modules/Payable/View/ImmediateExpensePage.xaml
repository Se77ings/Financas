<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Financas.Presentation.Modules.Payable.View.ImmediateExpensePage"
             Title="Despesas à Vista">

    <Grid RowDefinitions="Auto,*" Padding="20">
        
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <Label Grid.Column="0" 
                   Text="Despesas à Vista" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" />
            
            <Button Grid.Column="1"
                    Text="Adicionar"
                    Command="{Binding NavigateToAddCommand}"
                    BackgroundColor="Red"
                    TextColor="White" />
        </Grid>

        <ActivityIndicator Grid.Row="1"
                          IsRunning="{Binding IsBusy}" 
                          IsVisible="{Binding IsBusy}" 
                          Color="Blue"
                          VerticalOptions="Center"
                          HorizontalOptions="Center" />

        <CollectionView Grid.Row="1" 
                       ItemsSource="{Binding Items}"
                       SelectionMode="None">
            
            <CollectionView.EmptyView>
                <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
                    <Label Text="💸" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Nenhuma despesa à vista" 
                           FontSize="18" 
                           HorizontalOptions="Center" 
                           TextColor="Gray" />
                </StackLayout>
            </CollectionView.EmptyView>
            
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Excluir"
                                          BackgroundColor="Red"
                                          Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                          CommandParameter="{Binding Id}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        
                        <Grid Padding="15" ColumnDefinitions="*,Auto" BackgroundColor="LightGray" Margin="0,2">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToDetailsCommand}"
                                                    CommandParameter="{Binding Id}" />
                            </Grid.GestureRecognizers>
                            
                            <StackLayout Grid.Column="0" Spacing="5">
                                <Label Text="{Binding Description}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="Black" />
                                <Label Text="{Binding DueDate, StringFormat='Vencimento: {0:dd/MM/yyyy}'}" 
                                       FontSize="14" 
                                       TextColor="Gray" />
                            </StackLayout>
                            
                            <Label Grid.Column="1" 
                                   Text="{Binding Total, StringFormat='R$ {0:N2}'}" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   TextColor="Red" 
                                   VerticalOptions="Center" />
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
