<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Financas.Presentation.Modules.Payable.View.ImmediateExpenseFormPage"
             Title="Despesa à Vista">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">
            
            <Label Text="Descrição" FontAttributes="Bold" />
            <Entry Text="{Binding Description}" Placeholder="Ex: Supermercado" />

            <Label Text="Valor Bruto" FontAttributes="Bold" />
            <Entry Text="{Binding SubTotal}" Keyboard="Numeric" Placeholder="0,00" />

            <Label Text="Descontos" FontAttributes="Bold" />
            <Entry Text="{Binding Discounts}" Keyboard="Numeric" Placeholder="0,00" />

            <Label Text="Data de Vencimento" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="10">
                <Button Text="-" 
                        Command="{Binding SubtractDayCommand}"
                        BackgroundColor="#9E9E9E"
                        TextColor="White"
                        WidthRequest="40"
                        HeightRequest="40" />
                <DatePicker Date="{Binding DueDate}" HorizontalOptions="FillAndExpand" VerticalOptions="Center" />
                <Button Text="+" 
                        Command="{Binding AddDayCommand}"
                        BackgroundColor="#9E9E9E"
                        TextColor="White"
                        WidthRequest="40"
                        HeightRequest="40" />
            </HorizontalStackLayout>

            <Label Text="Observação" FontAttributes="Bold" />
            <Editor Text="{Binding Observation}" Placeholder="Observações..." HeightRequest="100" />

            <Button Text="Salvar"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#F44336"
                    TextColor="White"
                    Margin="0,20,0,0" />

            <Button Text="Salvar e Continuar"
                    Command="{Binding SaveAndContinueCommand}"
                    BackgroundColor="#2196F3"
                    TextColor="White" />

            <Button Text="Excluir"
                    Command="{Binding DeleteCommand}"
                    IsVisible="{Binding IsEditMode}"
                    BackgroundColor="#D32F2F"
                    TextColor="White" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                             IsVisible="{Binding IsBusy}" 
                             Color="Blue" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
