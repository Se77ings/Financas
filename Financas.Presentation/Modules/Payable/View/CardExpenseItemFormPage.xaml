<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Financas.Presentation.Modules.Payable.View.CardExpenseItemFormPage"
             Title="Adicionar Item">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">
            
            <Label Text="Descrição" FontAttributes="Bold" />
            <Entry Text="{Binding Description}" Placeholder="Ex: Compra Mercado" />

            <Label Text="Valor" FontAttributes="Bold" />
            <Entry Text="{Binding SubTotal}" Keyboard="Numeric" Placeholder="0,00" />

            <Label Text="Descontos" FontAttributes="Bold" />
            <Entry Text="{Binding Discounts}" Keyboard="Numeric" Placeholder="0,00" />

            <Label Text="Data" FontAttributes="Bold" />
            <DatePicker Date="{Binding DueDate}" />

            <Label Text="Parcela Atual" FontAttributes="Bold" />
            <Entry Text="{Binding CurrentInstallment}" Keyboard="Numeric" Placeholder="1" />

            <Label Text="Total de Parcelas" FontAttributes="Bold" />
            <Entry Text="{Binding QuantityInstallments}" Keyboard="Numeric" Placeholder="1" />

            <Label Text="Observação" FontAttributes="Bold" />
            <Editor Text="{Binding Observation}" Placeholder="Observações..." HeightRequest="80" />

            <Button Text="Salvar"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    Margin="0,20,0,0" />

            <Button Text="Excluir"
                    Command="{Binding DeleteCommand}"
                    IsVisible="{Binding IsEditMode}"
                    BackgroundColor="#F44336"
                    TextColor="White" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                             IsVisible="{Binding IsBusy}" 
                             Color="Blue" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
