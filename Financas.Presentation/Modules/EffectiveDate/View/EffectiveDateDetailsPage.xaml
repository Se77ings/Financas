<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Financas.Presentation.Modules.EffectiveDate.View.EffectiveDateDetailsPage"
             Title="{Binding View.Month, StringFormat='{0}/{1}', ConverterParameter={Binding View.Year}}">

    <Grid ColumnDefinitions="45*,5*,45*,5*" Padding="10" BackgroundColor="#F5F5F5">
        
        <!-- Lista Principal -->
        <Border Grid.Column="0" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" Padding="15" ColumnDefinitions="*,Auto,Auto,Auto" BackgroundColor="#FAFAFA">
                    <Label Grid.Column="0" Text="Extrato" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" TextColor="Black" />
                    
                    <Button Grid.Column="1" 
                            Text="+ Receber" 
                            Command="{Binding AddReceivableCommand}" 
                            BackgroundColor="#4CAF50" 
                            TextColor="White" 
                            Padding="10,5" 
                            Margin="0,0,5,0" />
                    
                    <Button Grid.Column="2" 
                            Text="+ À Vista" 
                            Command="{Binding AddImmediateExpenseCommand}" 
                            BackgroundColor="#F44336" 
                            TextColor="White" 
                            Padding="10,5" 
                            Margin="0,0,5,0" />
                    
                    <Button Grid.Column="3" 
                            Text="+ Cartão" 
                            Command="{Binding AddCardExpenseCommand}" 
                            BackgroundColor="#FF9800" 
                            TextColor="White" 
                            Padding="10,5" />
                </Grid>

                <CollectionView Grid.Row="1" ItemsSource="{Binding Transactions}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="Nenhuma transação" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="15,10" ColumnDefinitions="Auto,2*,Auto,*,Auto,Auto" BackgroundColor="White">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectTransactionCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                
                                <Label Grid.Column="0" Text="{Binding TypeIcon}" FontSize="20" FontAttributes="Bold" TextColor="{Binding TypeColor}" VerticalOptions="Center" Margin="0,0,10,0" />
                                
                                <Label Grid.Column="1" Text="{Binding Description}" FontAttributes="Bold" TextColor="Black" VerticalOptions="Center" />
                                
                                <Label Grid.Column="2" Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}" FontSize="14" TextColor="Gray" VerticalOptions="Center" Margin="10,0" />
                                
                                <StackLayout Grid.Column="3" HorizontalOptions="End">
                                    <Label Text="{Binding SubTotal, StringFormat='R$ {0:N2}'}" FontSize="12" TextColor="Gray" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding Discounts, StringFormat='- R$ {0:N2}'}" FontSize="11" TextColor="#F44336" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding Total, StringFormat='R$ {0:N2}'}" FontAttributes="Bold" TextColor="Black" HorizontalTextAlignment="End" />
                                </StackLayout>
                                
                                <Label Grid.Column="4" Text="✏️" FontSize="16" VerticalOptions="Center" Margin="10,0">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditTransactionCommand}" CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                
                                <BoxView Grid.Column="5" WidthRequest="4" BackgroundColor="{Binding TypeColor}" IsVisible="{Binding IsCardExpense}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid Grid.Row="2" Padding="15" RowDefinitions="Auto,Auto,1,Auto" BackgroundColor="#FAFAFA">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Subtotal:" FontSize="14" TextColor="Black" />
                        <Label Grid.Column="1" Text="{Binding TotalSubTotal, StringFormat='R$ {0:N2}'}" FontSize="14" FontAttributes="Bold" TextColor="Black" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Descontos:" FontSize="14" TextColor="#F44336" />
                        <Label Grid.Column="1" Text="{Binding TotalDiscounts, StringFormat='R$ {0:N2}'}" FontSize="14" TextColor="#F44336" />
                    </Grid>
                    <BoxView Grid.Row="2" HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,5" />
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Total:" FontSize="16" FontAttributes="Bold" TextColor="Black" />
                        <Label Grid.Column="1" Text="{Binding TotalNet, StringFormat='R$ {0:N2}'}" FontSize="16" FontAttributes="Bold" TextColor="#2196F3" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Detalhes Cartão -->
        <Border Grid.Column="2" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" Padding="15" BackgroundColor="#FFF3E0">
                    <Label Text="Itens do Cartão" FontSize="18" FontAttributes="Bold" TextColor="#FF9800" />
                </Grid>
                <CollectionView Grid.Row="1" ItemsSource="{Binding SelectedTransaction.CardItems}">
                    <CollectionView.EmptyView>
                        <Label Text="Selecione um cartão para visualizar os Detalhes" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" Padding="20" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="15,10" ColumnDefinitions="2*,Auto,*" BackgroundColor="White">
                                <Label Grid.Column="0" Text="{Binding Description}" FontAttributes="Bold" TextColor="Black" VerticalOptions="Center" />
                                
                                <Label Grid.Column="1" Text="{Binding DueDate, StringFormat='{0:dd/MM/yyyy}'}" FontSize="14" TextColor="Gray" VerticalOptions="Center" Margin="10,0" />
                                
                                <StackLayout Grid.Column="2" HorizontalOptions="End">
                                    <Label Text="{Binding SubTotal, StringFormat='R$ {0:N2}'}" FontSize="12" TextColor="Gray" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding Discounts, StringFormat='- R$ {0:N2}'}" FontSize="11" TextColor="#F44336" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding Total, StringFormat='R$ {0:N2}'}" FontAttributes="Bold" TextColor="#FF9800" HorizontalTextAlignment="End" />
                                </StackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Grid Grid.Row="2" Padding="15" BackgroundColor="#FFF3E0" IsVisible="{Binding SelectedTransaction}">
                    <Label Text="{Binding SelectedTransaction.Total, StringFormat='Total: R$ {0:N2}'}" FontSize="16" FontAttributes="Bold" TextColor="#FF9800" HorizontalOptions="End" />
                </Grid>
            </Grid>
        </Border>

        <ActivityIndicator Grid.Column="0" Grid.ColumnSpan="4" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#2196F3" />
    </Grid>
</ContentPage>
