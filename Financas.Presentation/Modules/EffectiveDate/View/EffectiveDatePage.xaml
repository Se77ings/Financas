<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Financas.Presentation.Modules.EffectiveDate.View.EffectiveDatePage"
             Title="Competências Financeiras">

    <Grid RowDefinitions="Auto,*" Padding="20">
        
        <!-- Header com botão de adicionar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <Label Grid.Column="0" 
                   Text="Suas Competências" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" />
            
            <Button Grid.Column="1"
                    Text="Nova Competência"
                    Command="{Binding AddEffectiveDateCommand}"
                    BackgroundColor="Blue"
                    TextColor="White" />
        </Grid>

        <!-- Loading indicator -->
        <ActivityIndicator Grid.Row="1"
                          IsRunning="{Binding IsBusy}" 
                          IsVisible="{Binding IsBusy}" 
                          Color="Blue"
                          VerticalOptions="Center"
                          HorizontalOptions="Center" />

        <!-- Lista de competências -->
        <CollectionView Grid.Row="1" 
                       ItemsSource="{Binding Items}"
                       SelectionMode="None">
            
            <CollectionView.EmptyView>
                <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
                    <Label Text="📊" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Nenhuma competência registrada" 
                           FontSize="18" 
                           HorizontalOptions="Center" 
                           TextColor="Gray" />
                    <Label Text="Toque em 'Nova Competência' para começar" 
                           FontSize="14" 
                           HorizontalOptions="Center" 
                           TextColor="Gray" />
                </StackLayout>
            </CollectionView.EmptyView>
            
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="15" ColumnDefinitions="*,Auto,Auto" BackgroundColor="LightGray" Margin="0,2">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateCommand}"
                                                CommandParameter="{Binding Id}" />
                        </Grid.GestureRecognizers>
                        
                        <StackLayout Grid.Column="0" Spacing="5">
                            <Label Text="{Binding Month}" 
                                   FontSize="18" 
                                   FontAttributes="Bold" 
                                   TextColor="Black" />
                            <Label Text="{Binding Year}" 
                                   FontSize="14" 
                                   TextColor="Gray" />
                        </StackLayout>
                        
                        <Label Grid.Column="1" 
                               Text="🗑️" 
                               FontSize="20" 
                               VerticalOptions="Center"
                               Margin="0,0,10,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                                    CommandParameter="{Binding Id}" />
                            </Label.GestureRecognizers>
                        </Label>
                        
                        <Label Grid.Column="2" 
                               Text=">" 
                               FontSize="20" 
                               TextColor="Blue" 
                               VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>