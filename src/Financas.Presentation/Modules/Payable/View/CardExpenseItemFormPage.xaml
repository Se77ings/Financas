<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Financas.Presentation.Modules.Payable.View.CardExpenseItemFormPage"
             Title="Adicionar Item">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">

            <Label Text="Descrição" FontAttributes="Bold" />
            <Entry Text="{Binding Description}" Placeholder="Ex: Compra Mercado" />


            <Grid ColumnDefinitions="Auto,Auto, Auto, Auto" ColumnSpacing="10">

                <HorizontalStackLayout>
                    <VerticalStackLayout Grid.Column="0" Margin="0,0,30,0">
                        <Label Text="Valor" FontAttributes="Bold" />
                        <Entry Text="{Binding SubTotal}" Keyboard="Numeric" Placeholder="0,00" WidthRequest="160" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Margin="0,0,30,0">
                        <Label Text="Descontos" FontAttributes="Bold" />
                        <Entry Text="{Binding Discounts}" Keyboard="Numeric" Placeholder="0,00" WidthRequest="160" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Margin="0,0,5,0">
                        <Label Text="Parcela" FontAttributes="Bold" />
                        <Entry Text="{Binding CurrentInstallment}" Keyboard="Numeric" Placeholder="1" WidthRequest="80" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="Total" FontAttributes="Bold" />
                        <Entry Text="{Binding QuantityInstallments}" Keyboard="Numeric" Placeholder="1" WidthRequest="80" />
                    </VerticalStackLayout>

                </HorizontalStackLayout>
            </Grid>
            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Margin="0,0,30,0">
                    <Label Text="Data" FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="-" 
                                Command="{Binding SubtractDayCommand}"
                                BackgroundColor="#9E9E9E"
                                TextColor="White"
                                WidthRequest="40"
                                HeightRequest="40" />
                        <DatePicker Date="{Binding DueDate}" HorizontalOptions="FillAndExpand" VerticalOptions="Center" />
                        <Button Text="+" 
                                Command="{Binding AddDayCommand}"
                                BackgroundColor="#9E9E9E"
                                TextColor="White"
                                WidthRequest="40"
                                HeightRequest="40" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

            </Grid>

            <Label Text="Observação" FontAttributes="Bold" />
            <Editor Text="{Binding Observation}" Placeholder="Observações..." HeightRequest="80" />

            <HorizontalStackLayout Spacing="10" Margin="0,20,0,0">
                <Button Text="Salvar"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        WidthRequest="200" />

                <Button Text="Salvar e Continuar"
                        Command="{Binding SaveAndContinueCommand}"
                        IsVisible="{Binding IsAddMode}"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        WidthRequest="200" />

                <Button Text="Excluir"
                        Command="{Binding DeleteCommand}"
                        IsVisible="{Binding IsEditMode}"
                        BackgroundColor="#F44336"
                        TextColor="White"
                        WidthRequest="200" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                             IsVisible="{Binding IsBusy}" 
                             Color="Blue" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
