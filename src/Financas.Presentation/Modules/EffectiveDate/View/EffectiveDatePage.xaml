<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Financas.Presentation.Modules.EffectiveDate.View.EffectiveDatePage"
             Title="Competências Financeiras">

    <Grid RowDefinitions="Auto,*" Padding="20">
        
        <!-- Header com botão de adicionar -->
            <Grid Grid.Row="0" ColumnDefinitions="*" Margin="0,0,0,20">
            <Label Grid.Column="0" 
                   Text="Suas Competências" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" />
        </Grid>

        <!-- Loading indicator -->
        <ActivityIndicator Grid.Row="1"
                          IsRunning="{Binding IsBusy}" 
                          IsVisible="{Binding IsBusy}" 
                          Color="Blue"
                          VerticalOptions="Center"
                          HorizontalOptions="Center" />

        <!-- Lista de competências agrupada por ano: linha por ano com meses em flex-row -->
        <CollectionView Grid.Row="1" 
                       ItemsSource="{Binding ItemsGrouped}"
                       SelectionMode="None">
            
            <CollectionView.EmptyView>
                <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
                    <Label Text="📊" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Nenhuma competência registrada" 
                           FontSize="18" 
                           HorizontalOptions="Center" 
                           TextColor="Gray" />
                    <Label Text="Toque em 'Nova Competência' para começar" 
                           FontSize="14" 
                           HorizontalOptions="Center" 
                           TextColor="Gray" />
                </StackLayout>
            </CollectionView.EmptyView>
            
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- Cada item aqui é um YearGroup -->
                    <StackLayout Padding="10" Spacing="8">
                        <Label Text="{Binding Year}" FontSize="20" FontAttributes="Bold" />
                        <!-- linha de meses -->
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <FlexLayout Direction="Row" AlignItems="Center" JustifyContent="Start" Wrap="NoWrap" Margin="0,5"
                                        BindableLayout.ItemsSource="{Binding Months}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Frame WidthRequest="72" HeightRequest="72" CornerRadius="8" BackgroundColor="White" HasShadow="True">
                                            <Grid>
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateCommand}"
                                                                        CommandParameter="{Binding Id}" />
                                                </Grid.GestureRecognizers>
                                                <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                                    <Label Text="{Binding MonthAbbreviation}" FontSize="14" TextColor="Black" FontAttributes="Bold" HorizontalOptions="Center" />
                                                    <Label Text="{Binding Year}" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                                                    <Label Text="{Binding Balance, StringFormat='R$ {0:N2}'}" FontSize="12" TextColor="Black" HorizontalOptions="Center" />
                                                </StackLayout>
                                            </Grid>
                                        </Frame>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </ScrollView>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>