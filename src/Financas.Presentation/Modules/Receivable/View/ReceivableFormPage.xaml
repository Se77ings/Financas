<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Financas.Presentation.Modules.Receivable.View.ReceivableFormPage"
             Title="Contas à Receber">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">
            
            <Label Text="Descrição" FontAttributes="Bold" />
            <Entry Text="{Binding Description}" Placeholder="Ex: Salário" />

            <Label Text="Valor Bruto" FontAttributes="Bold" />
            <Entry Text="{Binding SubTotal}" Keyboard="Numeric" Placeholder="0,00" WidthRequest="160" HorizontalOptions="Start" />

            <Label Text="Descontos" FontAttributes="Bold" />
            <Entry Text="{Binding Discounts}" Keyboard="Numeric" Placeholder="0,00" WidthRequest="160" HorizontalOptions="Start" />

            <Label Text="Data de Recebimento" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="10">
                <Button Text="-" 
                        Command="{Binding SubtractDayCommand}"
                        BackgroundColor="#9E9E9E"
                        TextColor="White"
                        WidthRequest="40"
                        HeightRequest="40" />
                <DatePicker Date="{Binding Date}" HorizontalOptions="FillAndExpand" VerticalOptions="Center" />
                <Button Text="+" 
                        Command="{Binding AddDayCommand}"
                        BackgroundColor="#9E9E9E"
                        TextColor="White"
                        WidthRequest="40"
                        HeightRequest="40" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10" Margin="0,20,0,0">
                <Button Text="Salvar"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        WidthRequest="200" />

                <Button Text="Salvar e Continuar"
                        Command="{Binding SaveAndContinueCommand}"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        WidthRequest="200" />

                <Button Text="Excluir"
                        Command="{Binding DeleteCommand}"
                        IsVisible="{Binding IsEditMode}"
                        BackgroundColor="#F44336"
                        TextColor="White"
                        WidthRequest="200" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                             IsVisible="{Binding IsBusy}" 
                             Color="Blue" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
